# Copy this file to .env.local for local development, and add the same values in Vercel → Settings → Environment Variables.

# Public URL of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL=https://vibeediting.app

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard → Account & Settings → Webhooks → the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Resend (resend.com) → API Keys. Without it, emails are only printed to the server log.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=vibe editing <hello@vibeediting.app>
